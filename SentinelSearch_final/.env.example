# ---- LLM Provider ----
# One of: anthropic | openai | ollama
LLM_PROVIDER=groq

ANTHROPIC_API_KEY=your-anthropic-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6

OPENAI_API_KEY=your-openai-key-here
OPENAI_MODEL=gpt-4o

# Only needed if LLM_PROVIDER=ollama. Requires `ollama serve` running locally.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# Free tier, no credit card — get a key at https://console.groq.com/keys
# Use LLM_PROVIDER=groq to run on this instead of Claude/OpenAI/Ollama.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Search Provider ----
# One of: duckduckgo (free, no key) | tavily | serper
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=
SERPER_API_KEY=

# ---- RAG ----
VECTOR_DB_PATH=./data/vector_db
DOCUMENTS_PATH=./data/documents
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# ---- Moderation / Safety ----
ENABLE_MODERATION=true

# ---- Misc ----
MAX_AGENT_ITERATIONS=6
LOG_LEVEL=INFO
